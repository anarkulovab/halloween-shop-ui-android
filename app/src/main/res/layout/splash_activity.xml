<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/header"
        android:layout_width="374.89dp"
        android:layout_height="126.52dp"
        android:layout_marginTop="75.24dp"
        android:fontFamily="@font/yeon_sung"
        android:text="@string/headline"
        android:textColor="@color/orange"
        android:textSize="90sp"
        android:rotation="-20.73"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>


    <ImageView
        android:id="@+id/imageView"
        android:layout_width="407.33dp"
        android:layout_height="425.97dp"
        android:layout_marginStart="-23.67dp"
        android:layout_marginTop="201.51dp"
        android:src="@drawable/logo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
    </ImageView>


</androidx.constraintlayout.widget.ConstraintLayout>