<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="312dp"
        android:layout_height="634dp"
        android:layout_marginTop="57dp"
        android:layout_marginStart="24dp"
        android:background="@drawable/profile_shape"
        android:orientation="vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="152dp"
                android:layout_height="143dp"
                android:layout_marginTop="50dp"
                android:layout_marginStart="24dp"
                android:src="@drawable/ghost">
            </ImageView>

            <TextView
                android:layout_width="105dp"
                android:layout_height="143dp"
                android:layout_marginTop="60dp"
                android:layout_marginStart="7dp"
                android:text="@string/name"
                android:textColor="@color/white"
                android:textSize="32sp"
                android:textAlignment="center"
                android:fontFamily="@font/yeon_sung">
            </TextView>
        </LinearLayout>

        <TextView
            android:layout_width="244dp"
            android:layout_height="248dp"
            android:layout_marginTop="143dp"
            android:layout_marginStart="24dp"
            android:text="@string/info"
            android:textSize="20sp"
            android:textColor="@color/white"
            android:fontFamily="@font/yeon_sung"
            android:textAlignment="center">
        </TextView>
    </LinearLayout>

    <LinearLayout
        android:layout_width="360dp"
        android:layout_height="57dp"
        android:layout_marginTop="742dp"
        android:background="@color/button"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:layout_width="39dp"
            android:layout_height="39dp"
            android:layout_marginStart="43dp"
            android:layout_marginTop="10dp"
            android:background="@null"
            android:src="@drawable/bt1"
            tools:ignore="SpeakableTextPresentCheck,TouchTargetSizeCheck"></ImageButton>

        <ImageButton
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="69dp"
            android:layout_marginTop="5dp"
            android:background="@null"
            android:src="@drawable/bt2"
            tools:ignore="SpeakableTextPresentCheck,TouchTargetSizeCheck"></ImageButton>

        <ImageButton
            android:layout_width="46dp"
            android:layout_height="40.12dp"
            android:layout_marginStart="66dp"
            android:layout_marginTop="8dp"
            android:background="@null"
            android:src="@drawable/bt3_white"
            tools:ignore="SpeakableTextPresentCheck,TouchTargetSizeCheck"></ImageButton>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>